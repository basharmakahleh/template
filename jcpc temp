const int MOD = 1e9+7;
 
inline ll add(ll a, ll b)
{
    return (a + b) % MOD;
}
 
inline ll sub(ll a, ll b)
{
    return (a - b + MOD) % MOD;
}
 
inline ll mul(ll a, ll b)
{
    return (ll)a * b % MOD;
}
 
ll power(ll x, ll p)
{
    ll ret = 1;
    while (p > 0)
    {
        if (p % 2)
            ret = mul(ret, x);
        p /= 2;
        x = mul(x, x);
    }
    return ret;
}
 
ll inv(ll x)
{
    return power(x, MOD - 2);
}
 
inline ll divide(ll a, ll b)
{
    return mul(a, inv(b));
}
