vector<vector<long long>> pbuild(const vector<vector<long long>> &a)
{
    if (a.empty() || a[0].empty())
        return {};
 
    int n = a.size();
    int m = a[0].size();
 
    vector<vector<long long>> pref(n + 1, vector<long long>(m + 1, 0));
 
    for (int i = 1; i <= n; i++)
    {
        for (int j = 1; j <= m; j++)
        {
            pref[i][j] = a[i - 1][j - 1] + pref[i - 1][j] + pref[i][j - 1] - pref[i - 1][j - 1];
        }
    }
 
    return pref;
}
 
struct sp
{
    vector<ll> arr;
    vector<vector<ll>> freq;
    ll logs;
    ll n;
    sp(vector<ll> &a)
    {
        arr = a;
        n = arr.size();
        logs = 63 - __builtin_clzll(n) + 1;
        freq.resize(logs);
    }
    void build()
    {
        for (int i = 0; i < n; i++)
            freq[0].push_back(arr[i]);
        for (int i = 1; i < logs; i++)
        {
            for (int j = 0; j + (1 << (i - 1)) < freq[i - 1].size(); j++)
            {
                freq[i].push_back(min(freq[i - 1][j], freq[i - 1][j + ((1 << (i - 1)))]));
            }
        }
    }
    ll query(ll l, ll r)
    {
        if (l > r)
            return oo;
        --l;
        --r;
        ll len = r - l + 1;
        if (len <= 0)
            return oo;
 
        ll k = 63 - __builtin_clzll(len);
 
        if (logs == 0)
            return oo;
        if (k >= logs)
            k = logs - 1;
        return min(freq[k][l], freq[k][r - (1LL << k) + 1]);
 
        return oo;
    }
};
 
const ll MAXA = 2e5;
vector<ll> spf(MAXA + 1);
void sieve()
{
    for (int i = 1; i <= MAXA; i++)
        spf[i] = i;
    for (int i = 2; i * i <= MAXA; i++)
    {
        if (spf[i] == i)
        {
            for (int j = i * i; j <= MAXA; j += i)
            {
                if (spf[j] == j)
                {
                    spf[j] = i;
                }
            }
        }
    }
}
vpll get_divisors(int x)
{
    vector<pair<ll, ll>> fac;
    while (x > 1)
    {
        ll p = spf[x], cnt = 0;
        while (x % p == 0)
        {
            x /= p;
            cnt++;
        }
        fac.push_back({p, cnt});
    }
    return fac;
vector<ll> divs = {1};
for (auto [p, c] : fac)
{
    ll sz = divs.size();
    ll cur = 1;
    for (int i = 1; i <= c; i++)
    {
        cur *= p;
        for (int j = 0; j < sz; j++)
            divs.push_back(divs[j] * cur);
    }
}
return divs;
