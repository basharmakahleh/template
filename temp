 void euler(ll curr,ll parent,ll &time,vector<vll> &adj,vll &start,vll &end){
    start[curr] = time++;
    for(auto it : adj[curr]){
        if(it == parent) continue;
        euler(it,curr,time,adj,start,end);
    }
    end[curr] = time-1;
}


struct seg {
    int n; vector<int> t;
    seg(int tn){
        n = tn; t.resize(4 * n, 0);
    }

    void upd(int s, int e, int i, int qi, int v) {
        if (s == e) {
            t[i] += v; return;
        }
        int m = (s + e) / 2;
        if(qi <= m) upd(s, m, 2 * i, qi, v);
        else        upd(m + 1, e, 2 * i + 1, qi, v);
        t[i] = mul(t[2 * i],t[2 * i + 1]);
    }
    int qry(int s, int e, int i, int l, int r) {
        if (s > r || e < l) return 1;
        if (s >= l && e <= r) return t[i];
        int m = (s + e) / 2;
        return mul(qry(s, m, 2 * i, l, r), qry(m + 1, e, 2 * i + 1, l, r));
    }
};

struct lca{
    vll depth;
    vector<array<int,20>> up;
    vector<array<int,20>> mx;
    vector<array<int,20>> mn;
    ll log;
    ll n;
    lca(vector<vpll> &adj){
        n = adj.size();
        log = 20;
        depth.resize(n,-1);
        up.assign(n, array<int, 20>{});
        mx.assign(n, array<int, 20>{0});
        mn.assign(n, array<int, 20>{INT_MAX});
        up[0][0] = 0;
        queue<ll> q;
        q.push(0);
        depth[0] = 0;
        while(!q.empty()){
            ll curr = q.front();
            q.pop();
            for(auto [w,it] : adj[curr]){
                if(depth[it] != -1) continue;
                depth[it] = depth[curr]+1;
                up[it][0] = curr;
                mx[it][0] = w;
                mn[it][0] = w;
                q.push(it);
            }
        }
        for(int l = 1;l<log;l++){
            for(int i = 0;i<n;i++){
                up[i][l] = up[up[i][l-1]][l-1];
                ll half =  up[i][l-1];
                mx[i][l] = max(mx[i][l-1],mx[half][l-1]);
                mn[i][l] = min(mn[i][l-1],mn[half][l-1]);
            }
        }

    }

    ll getkth(ll node,ll k){
        ll curr = node;
        if(k > depth[node]) return -1;
        for(int i = 0;i<log;i++){
            if((1LL<<i)&k){
                curr = up[curr][i];
            }
        }
        return curr;
    }

    ll getlca(ll x, ll y){
        if(depth[x] > depth[y]){
            x = getkth(x,depth[x] - depth[y]);
        }
        if(depth[y] > depth[x]){
            y = getkth(y,depth[y] - depth[x]);
        }
        if(x == y){
            return x;
        }

        for(int i = log-1;i>=0;i--){
            if(up[x][i]  == up[y][i]) continue;
            x = up[x][i];
            y = up[y][i];
        }
        ll node = up[x][0];
        return node;
    }
    void print(ll x,ll y){
        ll parent = getlca(x,y);
        ll mxx = 0;
        ll mnn = oo;
        ll xdiff = depth[x] - depth[parent];
        for(int i = 20;i>=0;i--){
            if((1<<i) & xdiff){
                mxx = max(mxx,(ll)mx[x][i]);
                mnn = min(mnn,(ll)mn[x][i]);
                xdiff-= 1<<i;
                x = up[x][i];
            }
        }
        ll ydiff = depth[y] - depth[parent];
        for(int i = 19;i>=0;i--){
            if((1<<i) & ydiff){
                mxx = max(mxx,(ll)mx[y][i]);
                mnn = min(mnn,(ll)mn[y][i]);
                ydiff-= 1<<i;
                y = up[y][i];
            }
        }
        cout<<mnn<<" "<<mxx<<endl;
    }
};
