struct dsu
{
    vll parent;
    vll size;
    ll largest;
    ll components;
    dsu(ll n)
    {
        parent.resize(n + 1);
        iota(parent.begin(), parent.end(), 0);
        size.resize(n + 1, 1);
        largest = 1;
        components = n;
    }
    void make_set(ll v)
    {
        parent[v] = v;
        size[v] = 1;
    }
 
    ll find_set(ll v)
    {
        if (v == parent[v])
            return v;
        return parent[v] = find_set(parent[v]);
    }
 
    void union_sets(ll a, ll b)
    {
        a = find_set(a);
        b = find_set(b);
        if (a == b)
            return;
        if (size[a] < size[b])
            swap(a, b);
        parent[b] = a;
        size[a] += size[b];
        largest = max(size[a], largest);
        components--;
    }
};
 
struct Fenwick
{
    int n;
    vll bit;
    Fenwick(int _n = 0)
    {
        init(_n);
    }
    void init(int _n)
    {
        n = _n;
        bit.assign(n + 1, 0);
    }
 
    // O(n) build from 1-based array a (a[0] ignored)
    Fenwick(const vector<ll> &a)
    {
        n = (int)a.size() - 1;
        bit = a; // copy
        for (int i = 1; i <= n; ++i)
        {
            int j = i + (i & -i);
            if (j <= n)
                bit[j] += bit[i];
        }
    }
 
    void add(int idx, ll val)
    {
        for (; idx <= n; idx += idx & -idx)
            bit[idx] += val;
    }
    ll sum(int idx) const
    {
        ll res = 0;
        for (; idx > 0; idx -= idx & -idx)
            res += bit[idx];
        return res;
    }
};
 
struct FenwickRange
{
    int n;
    Fenwick B1, B2;
    FenwickRange()
    {
        n = 0;
    }
    FenwickRange(int _n)
    {
        init(_n);
    }
    void init(int _n)
    {
        n = _n;
        B1.init(n);
        B2.init(n);
    }
 
    // Build in O(n) from 0-based array a0
    FenwickRange(const vector<ll> &a0)
    {
        int m = (int)a0.size();
        n = m;
        // 1-based A
        vector<ll> A(n + 1, 0);
        for (int i = 1; i <= n; ++i)
            A[i] = a0[i - 1];
 
        // D[i] = A[i] - A[i-1]
        vector<ll> D(n + 1, 0);
        for (int i = 1; i <= n; ++i)
            D[i] = A[i] - A[i - 1];
 
        // prepare 1-based raw arrays for B1 and B2
        vector<ll> rawB1(n + 1, 0), rawB2(n + 1, 0);
        for (int i = 1; i <= n; ++i)
        {
            rawB1[i] = D[i];
            rawB2[i] = D[i] * (ll)(i - 1);
        }
 
        B1 = Fenwick(rawB1); // O(n)
        B2 = Fenwick(rawB2); // O(n)
    }
 
    // range add [l..r] (1-based)
    void range_add1(int l, int r, ll val)
    {
        if (l > r)
            return;
        B1.add(l, val);
        B1.add(r + 1, -val);
        B2.add(l, val * (l - 1));
        B2.add(r + 1, -val * r);
    }
 
    // prefix sum [1..idx] (1-based)
    ll prefix_sum1(int idx) const
    {
        if (idx <= 0)
            return 0;
        ll s1 = B1.sum(idx);
        ll s2 = B2.sum(idx);
        return s1 * idx - s2;
    }
 
    // range sum [l..r] (1-based)
    ll range_sum1(int l, int r) const
    {
        if (r < l)
            return 0;
        return prefix_sum1(r) - prefix_sum1(l - 1);
    }
};
 
