int power(int x, int p)
{
    int ret = 1;
    while (p > 0)
    {
        if (p % 2)
            ret = mul(ret, x);
        p /= 2;
        x = mul(x, x);
    }
    return ret;
}
 
int inv(int x)
{
    return power(x, MOD - 2);
}
 
inline int divide(int a, int b)
{
    return mul(a, inv(b));
}
